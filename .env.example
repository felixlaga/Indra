# Indra API and research providers
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set a model that supports structured outputs when enabling model verification.
OPENROUTER_MODEL=

# Repository backend: memory for local experiments, postgres for durable use
INDRA_REPOSITORY_BACKEND=memory
INDRA_DATABASE_URL=postgresql://indra:indra@localhost:5432/indra

# Browser origins allowed to call the API
INDRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional local API protection. Leave blank for trusted local development.
# With accounts on, this key is the service key for workers and operators.
INDRA_API_KEY=

# "accounts" requires sign-in and limits each user to their own projects.
# "off" (default) is single-user local mode.
INDRA_AUTH_MODE=off
# Allow new accounts after the first one (the first account is always allowed).
INDRA_ALLOW_SIGNUP=true

# Optional: a contact email OpenAlex uses to route requests to its faster "polite pool".
INDRA_CONTACT_EMAIL=

# Optional semantic evidence retrieval. Naming a Hugging Face sentence-embedding model
# downloads it (about 90 MB for this one) on first use and runs it locally on CPU.
# Leave blank for word-overlap retrieval only.
INDRA_EMBEDDING_MODEL=
# INDRA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional paper-provider configuration.
# Without an API key, Semantic Scholar's shared pool rate-limits heavily.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
HALUGATE_URL=http://localhost:8000

# Standalone research workers share Postgres with the API.
# Start with: python -m src.jobs.research_worker
# Also run: python -m src.jobs.view_worker (cached maps and advisor results)
# Without OPENROUTER_API_KEY, research produces source excerpts and claims needing review.
