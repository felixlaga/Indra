# Copy to deploy/.env and fill in. deploy/.env is ignored by git.
# Generate secrets with: openssl rand -base64 32

# Database password (internal to the compose network).
POSTGRES_PASSWORD=
# Service key for workers and operators; the dashboard keeps it server-side.
INDRA_API_KEY=

# Accounts are on by default. The first account adopts existing work; set
# INDRA_ALLOW_SIGNUP=true to let more people create accounts afterwards.
INDRA_AUTH_MODE=accounts
INDRA_ALLOW_SIGNUP=false

# Research model (optional; without it claims are left for review).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional.
SEMANTIC_SCHOLAR_API_KEY=
INDRA_CONTACT_EMAIL=
# Downloads about 90 MB into the models volume on first use.
INDRA_EMBEDDING_MODEL=

# Ports on this machine. Put HTTPS (for example Caddy or a cloud load balancer) in
# front of the dashboard port for anything beyond your own computer.
INDRA_WEB_PORT=3000
INDRA_API_PORT=8000
